# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
# Generate passwords with:  openssl rand -hex 24

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=wykojdb
MYSQL_USER=wykoj
MYSQL_PASSWORD=

# After filling these in, point DB_URI in config.json at the container:
#   "DB_URI": "mysql://wykoj:<MYSQL_PASSWORD>@wykoj-db/wykojdb"
# Note the host is the container name, resolved over the wykoj-net network.

# --- backup.sh ---
# Not configured yet. The RDS instance is being kept running as the fallback
# copy instead, frozen at cutover - which means anything written after cutover
# lives on one disk until this is filled in. See PR #21.
#
# Leave BACKUP_S3_DEST unset rather than filling in a placeholder: backup.sh
# fails fast with "not set in .env" instead of dumping first and then failing
# on upload.
#
# Destination options:
#   S3           BACKUP_S3_DEST=s3://your-bucket/wykoj-backups
#                plus AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
#                AWS_DEFAULT_REGION here (backup.sh exports this file, so the
#                aws CLI picks them up with no extra wiring). Scope the IAM
#                user to s3:PutObject only, so a compromised server can add
#                backups but not erase the history.
#   Google Drive service account + Shared Drive via rclone, swapping the
#                `aws s3 cp` line for `rclone copy`.
#   Back to RDS  stream the dump into the retained instance; only valid after
#                cutover, and only if its BackupRetentionPeriod is > 0.
#
#BACKUP_S3_DEST=

# Days of dumps to keep locally. Remote retention is separate - an S3
# lifecycle rule, or `rclone delete --min-age` followed by `rclone cleanup`.
BACKUP_KEEP_DAYS=7
