# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
# Generate passwords with:  openssl rand -hex 24

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=wykojdb
MYSQL_USER=wykoj
MYSQL_PASSWORD=

# After filling these in, point DB_URI in config.json at the container:
#   "DB_URI": "mysql://wykoj:<MYSQL_PASSWORD>@wykoj-db/wykojdb"
# Note the host is the container name, resolved over the wykoj-net network.

# --- backup.sh ---
# Google Cloud Storage via rclone. Set up the remote once on the server:
#   rclone config create wykgcs "google cloud storage" \
#     service_account_file="$HOME/.config/wykoj/gcs-sa.json" \
#     bucket_policy_only=true
# The service account holds objectCreator + objectViewer only - it can write
# new backups and read them, but cannot delete or overwrite existing ones, so
# a compromised server cannot destroy backup history. Remote retention is
# therefore the bucket's lifecycle rule, not this script.
# Keep the key outside the repo: .gitignore covers config.json and .env by
# name, so a service account key dropped beside them is committable.
BACKUP_RCLONE_DEST=wykgcs:wykoj-db-backups

# Days of dumps to keep locally. Remote retention is separate and server-side:
# the bucket's lifecycle rule. It cannot be done from here - the uploader has
# no delete permission, which is the point.
BACKUP_KEEP_DAYS=7
