# Copy to .env (gitignored) and fill in.
#
# Read by docker-compose.yml, scripts/backup.sh and scripts/restore.sh.
# Generate passwords with:  openssl rand -hex 24

# --- database (always required) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=wykojdb
MYSQL_USER=wykoj
MYSQL_PASSWORD=

# Once these are set, point DB_URI in config.json at the container:
#   "DB_URI": "mysql://wykoj:<MYSQL_PASSWORD>@wykoj-db/wykojdb"
# The host is the container name, resolved over the wykoj-net network.

# --- backups (deployments only) ---
# Only scripts/backup.sh reads this. Leave it unset for local development:
# docker compose and scripts/restore.sh work without it, and neither rclone
# nor gcloud needs to be installed. backup.sh refuses to run when it is unset
# rather than dumping and then failing to upload.
#
# To set one up, see "Creating the bucket and credentials" in README.md.
#BACKUP_RCLONE_DEST=wykgcs:wykoj-db-backups

# Days of dumps to keep on this server. How long they are kept in the bucket
# is separate and set by its lifecycle rule, because the uploading service
# account has no permission to delete anything.
BACKUP_KEEP_DAYS=7
